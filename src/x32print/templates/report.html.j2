<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ scene.name }} — x32print</title>
  <style>{{ css }}</style>
</head>
<body>
  <div class="toolbar"><button onclick="window.print()">Print / Save PDF</button></div>
  <header class="report-header">
    <div>
      <div class="eyebrow">X32 SYSTEM DOCUMENTATION</div>
      <h1>{{ scene.name }}</h1>
      <p class="subtitle">Input patch, stage connections, and monitor buses</p>
    </div>
    <div class="brand">x32print <span>v{{ version }}</span></div>
  </header>

  <section>
    <h2>Input Channels</h2>
    <table class="input-table">
      <thead><tr><th>Mixer</th><th>Source</th><th>Label</th><th class="color-head">Color</th><th class="notes-head">Notes</th></tr></thead>
      <tbody>
      {% for channel in scene.channels %}
        <tr>
          <td class="number">{{ channel.number }}</td>
          <td class="source">{{ channel.source.display() if channel.source else "—" }}</td>
          <td class="label">{{ channel.label }}</td>
          <td class="color-cell"><span class="swatch" style="background: {{ channel.scribble_color or '#bdc3c7' }}"></span></td>
          <td class="notes">{{ channel.notes }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="empty">No channel configuration entries were recognized.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="stage-section">
    <h2>Stage Patch Summary</h2>
    <p class="section-note">Stage-box assignments will appear here once scene input routing is decoded.</p>
    <div class="notice">Routing is not yet interpreted. This report does not assume that mixer channels 1–16 or 17–32 correspond to particular stage boxes.</div>
  </section>

  <section class="bus-section">
    <h2>Monitor Busses</h2>
    <table>
      <thead><tr><th>Bus</th><th>Name</th><th class="notes-head">Notes</th></tr></thead>
      <tbody>
      {% for bus in scene.buses if bus.number <= 16 %}
        <tr><td class="number">{{ bus.number }}</td><td>{{ bus.name }}</td><td class="notes">{{ bus.notes }}</td></tr>
      {% else %}
        <tr><td colspan="3" class="empty">No bus configuration entries were recognized.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  {% if warnings %}
  <section class="validation">
    <h2>Validation</h2>
    <ul>{% for warning in warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  <footer>Generated by x32print · v{{ version }} · {{ scene.name }}</footer>
</body>
</html>
