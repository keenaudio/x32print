<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ scene.name }} — X32 channel list</title>
<style>
{{ css | safe }}
</style>
</head>
<body>
<div class="toolbar no-print">
  <button onclick="window.print()">Print</button>
  <span>Tip: set landscape orientation and enable “Background graphics” to print scribble colours.</span>
</div>

{% macro swatch(ch) -%}
<span class="name-chip" style="background: {{ ch.scribble_color }}; color: {{ ch.scribble_color | text_color }}">
  {{- ch.label or "—" -}}
</span>
{%- endmacro %}

{# ---------------------------------------------------------------- inputs #}
<section class="page">
  <header class="page-head">
    <h1>{{ scene.name }}</h1>
    <div class="meta">Input channel list · generated {{ generated }}</div>
  </header>
  <table class="list">
    <thead>
      <tr>
        <th class="num">Ch</th><th>Name</th><th>Source</th>
        <th class="r">Gain</th><th class="c">48V</th><th class="r">Trim</th><th class="r">HPF</th><th class="c">Link</th>
      </tr>
    </thead>
    <tbody>
    {% for ch in scene.channels %}
      <tr class="{{ '' if ch is used else 'unused' }}{{ ' link-top' if ch.linked and ch.number is odd }}{{ ' link-bottom' if ch.linked and ch.number is even }}">
        <td class="num">{{ ch.display_id }}</td>
        <td>{{ swatch(ch) }}</td>
        <td class="src src-{{ ch.source.source_type if ch.source else 'none' }}">{{ ch.source.display() if ch.source else "?" }}</td>
        <td class="r">{{ ch.gain | gain }}</td>
        <td class="c">{% if ch.phantom %}<span class="phantom">48V</span>{% endif %}</td>
        <td class="r">{{ ch.trim | gain if ch.trim else "" }}</td>
        <td class="r">{{ ch.hpf_freq | freq if ch.hpf_on else "" }}</td>
        <td class="c">{{ "L" if ch.linked and ch.number is odd else ("R" if ch.linked else "") }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

{# ------------------------------------------------------------ stage boxes #}
{% for box in scene.stageboxes %}
<section class="page stagebox">
  <header class="page-head">
    <h1>{{ box.name }}</h1>
    <div class="meta">{{ scene.name }} · {{ box.sockets | length }} inputs · generated {{ generated }}</div>
  </header>
  <table class="box">
    <thead>
      <tr><th class="sock">Input</th><th>Channel</th><th class="c">48V</th><th class="r">Gain</th></tr>
    </thead>
    <tbody>
    {% for socket in box.sockets %}
      {% set used = socket.channels | select("used") | list %}
      <tr class="{{ '' if used else 'empty' }}">
        <td class="sock">{{ socket.port }}</td>
        <td>
          {% for ch in used %}
            <div class="box-ch">
              <span class="box-chnum">{{ ch.display_id if ch.kind == "auxin" else "Ch " ~ ch.display_id }}</span>
              {{ swatch(ch) }}
            </div>
          {% else %}
            <span class="blank-line"></span>
          {% endfor %}
        </td>
        <td class="c">{% if socket.phantom %}<span class="phantom big">48V</span>{% endif %}</td>
        <td class="r">{{ socket.gain | gain if used else "" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>
{% endfor %}

{# ---------------------------------------------------------- monitor sends #}
{% if mixes.rows %}
<section class="page">
  <header class="page-head">
    <h1>Monitor &amp; mix sends</h1>
    <div class="meta">{{ scene.name }} · send levels in dB · generated {{ generated }}</div>
  </header>
  <table class="sends">
    <thead>
      <tr>
        <th class="num">Ch</th><th>Name</th>
        {% for col in mixes.columns %}
        <th class="bus-col">
          <div class="bus-num">{{ col.label }}{% if col.stereo %} <span class="st">ST</span>{% endif %}</div>
          <div class="bus-name" style="background: {{ col.color }}; color: {{ col.color | text_color }}">{{ col.name or "—" }}</div>
          <div class="bus-tap">{{ tap_labels.get(col.tap, col.tap) if col.tap else "" }}</div>
        </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
    {% for row in mixes.rows %}
      <tr>
        <td class="num">{{ row.strip.display_id }}</td>
        <td>{{ swatch(row.strip) }}</td>
        {% for send in row.cells %}
          {% set col = mixes.columns[loop.index0] %}
          {% if send %}
          <td class="lvl">
            {{- send.level | db -}}
            {% if col.stereo %}<span class="pan">{{ send.pan | pan }}</span>{% endif %}
            {% if send.tap and send.tap != col.tap %}<span class="tap">{{ tap_labels.get(send.tap, send.tap) }}</span>{% endif %}
          </td>
          {% else %}
          <td class="lvl off"></td>
          {% endif %}
        {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="footnote">Only sends that are switched on with a level above −∞ are shown. The tap under each bus is the most common send point;
    cells tagged otherwise use a different tap. Stereo-linked bus pairs (ST) share one column, with pan shown.</p>
</section>
{% endif %}

{# ------------------------------------------------------- aux in + buses #}
<section class="page">
  <header class="page-head">
    <h1>Aux inputs &amp; mix buses</h1>
    <div class="meta">{{ scene.name }}</div>
  </header>
  <div class="cols">
    <div>
      <h2>Aux inputs</h2>
      <table class="list">
        <thead><tr><th class="num">Aux</th><th>Name</th><th>Source</th><th class="c">Link</th></tr></thead>
        <tbody>
        {% for ch in scene.aux_inputs %}
          <tr class="{{ '' if ch is used else 'unused' }}">
            <td class="num">{{ ch.number }}</td>
            <td>{{ swatch(ch) }}</td>
            <td class="src">{{ ch.source.display() if ch.source else "?" }}</td>
            <td class="c">{{ "L" if ch.linked and ch.number is odd else ("R" if ch.linked else "") }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div>
      <h2>Mix buses</h2>
      <table class="list">
        <thead><tr><th class="num">Bus</th><th>Name</th></tr></thead>
        <tbody>
        {% for bus in scene.buses %}
          <tr class="{{ '' if bus.name else 'unused' }}">
            <td class="num">{{ "%02d" | format(bus.number) }}</td>
            <td><span class="name-chip" style="background: {{ bus.color }}; color: {{ bus.color | text_color }}">{{ bus.name or "—" }}</span></td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {% if warnings %}
  <h2>Notes &amp; warnings</h2>
  <ul class="warnings">
    {% for w in warnings %}<li>{{ w }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if scene.routing.input_tokens %}
  <p class="footnote">Input routing: {{ scene.routing.input_tokens | join(" · ") }}</p>
  {% endif %}
</section>
</body>
</html>
